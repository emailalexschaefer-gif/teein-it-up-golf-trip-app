# ─────────────────────────────────────────────────────────────────────────────
# TEEIN' IT UP — Environment Variables
# Copy this file to .env.local and fill in your Supabase values.
# In Vercel: add these variables under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# From your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-side only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# GA4 / Product Analytics — the production MVP's own GA4 Web Data
# Stream Measurement ID (from GA4 Admin → Data Streams → your web
# stream). Optional: if unset, analytics simply never loads — see
# src/components/analytics/GoogleAnalytics.tsx and
# src/lib/analytics/trackEvent.ts, both fail safe with no ID present.
# Do NOT hard-code a real Measurement ID anywhere else in the codebase.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─────────────────────────────────────────────────────────────────────────────
# V8 AMBROSE (gross) -- feature switches. NEXT_PUBLIC_* values are inlined at BUILD time:
# set them in Vercel BEFORE building, and redeploy after any change.
#
# NORMAL PRODUCTION (Ambrose OFF -- leave all of these unset, or set the flag to anything but "true"):
#   NEXT_PUBLIC_APP_ENV=production
#
# PRODUCTION TEST (Ambrose ON for named private test events ONLY):
#   NEXT_PUBLIC_AMBROSE_ENABLED=true
#   NEXT_PUBLIC_AMBROSE_PRODUCTION_TRIP_IDS=<trip-uuid>[,<trip-uuid>...]   (the id in the event's URL: /trips/<uuid>/...)
#   Only the listed events see Ambrose; every other event is untouched, and the server answers 404 to Ambrose requests for them.
#   To end the test: remove NEXT_PUBLIC_AMBROSE_ENABLED, redeploy.
#
# STAGING / PREVIEW (a separate non-production project -- Ambrose ON for every event):
#   NEXT_PUBLIC_AMBROSE_ENABLED=true
#   NEXT_PUBLIC_APP_ENV=staging
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_AMBROSE_ENABLED=true
# NEXT_PUBLIC_AMBROSE_PRODUCTION_TRIP_IDS=00000000-0000-0000-0000-000000000000
# NEXT_PUBLIC_APP_ENV=production
