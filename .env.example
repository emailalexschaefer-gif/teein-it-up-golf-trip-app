# ─────────────────────────────────────────────────────────────────────────────
# TEEIN' IT UP — Environment Variables
# Copy this file to .env.local and fill in your Supabase values.
# In Vercel: add these variables under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# From your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-side only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# GA4 / Product Analytics — the production MVP's own GA4 Web Data
# Stream Measurement ID (from GA4 Admin → Data Streams → your web
# stream). Optional: if unset, analytics simply never loads — see
# src/components/analytics/GoogleAnalytics.tsx and
# src/lib/analytics/trackEvent.ts, both fail safe with no ID present.
# Do NOT hard-code a real Measurement ID anywhere else in the codebase.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
